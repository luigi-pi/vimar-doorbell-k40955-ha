# Settings of the door bridge on the monitor. Copy this file to "bridge.conf" in the top folder
# of the kit and replace the three values in <...>. Lines starting with # are ignored.

# IP address of your MQTT broker (normally your Home Assistant). A number, not a name.
host=<HA_IP>
# Port of the broker's encrypted (TLS) listener.
port=8883
# MQTT user and password created for the doorbell in Home Assistant.
user=<MQTT_USER>
pass=<MQTT_PASSWORD>

# Leave the lines below as they are.
cert=/mntfs/vimarbridge/broker.pem
base=vimar/k40955
node=vimar_k40955
